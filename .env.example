# ------------------------------------------------------------------
# Webent — server environment (.env.example)
# Copy to .env and fill in. Never commit real secrets.
# ------------------------------------------------------------------

# Port for the API / production server
PORT=8787

# Public URL of the deployed site (used for canonical URLs, sitemap.xml, robots.txt)
SITE_URL=http://localhost:5173

# Path to the SQLite database directory (kept outside the public build)
DATA_DIR=./data

# ---- Admin panel (optional) --------------------------------------
# Set a strong password to enable /admin. Leave empty to disable the panel.
# Generate a hash-free strong value, e.g.: openssl rand -base64 24
ADMIN_PASSWORD=

# ---- Optional e-mail notifications -------------------------------
# Inquiry storage works without these. Notifications only send when ALL are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=webentstudio@gmail.com
# SMTP_PASS=your-app-password
# MAIL_TO=webentstudio@gmail.com
# MAIL_FROM=Webent <webentstudio@gmail.com>
